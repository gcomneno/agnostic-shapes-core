    given-names: "Giancarlo"
    alias: "gcomneno"
repository-code: "https://github.com/gcomneno/agnostic-shapes-core"
url: "https://github.com/gcomneno/agnostic-shapes-core"
license: MIT
version: 0.1.0
keywords:
  - "COLLATZ"
  - "SHAPES"
  - "structural seed"
  - "STR"
  - "research software"
